{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/petition",
      "destination": "/take-action/defend-sacred-ground#sign",
      "permanent": false
    },
    {
      "source": "/sign",
      "destination": "/take-action/defend-sacred-ground#sign",
      "permanent": false
    },
    {
      "source": "/demand",
      "destination": "/minister#ff-email-form",
      "permanent": false
    },
    {
      "source": "/demandvid",
      "destination": "/minister#video",
      "permanent": false
    },
    {
      "source": "/contact-the-minister",
      "destination": "/minister",
      "permanent": false
    },
    {
      "source": "/volunteer-signup",
      "destination": "/volunteer#signup",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/about-us",
      "permanent": false
    },
    {
      "source": "/evidence",
      "destination": "/the-issue",
      "permanent": false
    },
    {
      "source": "/issue",
      "destination": "/the-issue",
      "permanent": false
    },
    {
      "source": "/press",
      "destination": "/media",
      "permanent": false
    },
    {
      "source": "/media-kit",
      "destination": "/media",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/shop",
      "destination": "/shop.html"
    },
    {
      "source": "/wa2",
      "destination": "/api/wa-redirect?v=wa2"
    },
    {
      "source": "/wa1",
      "destination": "/api/wa-redirect?v=wa1"
    },
    {
      "source": "/reception",
      "destination": "/reception.html"
    },
    {
      "source": "/fund",
      "destination": "/api/track-redirect?l=fund"
    },
    {
      "source": "/give",
      "destination": "/api/track-redirect?l=give"
    },
    {
      "source": "/fight",
      "destination": "/api/track-redirect?l=fight"
    },
    {
      "source": "/go/:link",
      "destination": "/api/track-redirect?l=:link"
    },
    {
      "source": "/leaderboard",
      "destination": "/api/leaderboard"
    },
    {
      "source": "/s/:slug",
      "destination": "/survey"
    },
    {
      "source": "/supporters/:slug",
      "destination": "/webinar"
    },
    {
      "source": "/supporters",
      "destination": "/webinar"
    },
    {
      "source": "/take-action/:slug",
      "destination": "/take-action/defend-sacred-ground"
    }
  ],
  "headers": [
    {
      "source": "/content/site.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/survey/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/meta-lead-webhook.js": {
      "maxDuration": 60
    },
    "api/meta-lead-pull.js": {
      "maxDuration": 60
    },
    "api/unit-economics.js": {
      "maxDuration": 300
    },
    "api/ad-insights.js": {
      "maxDuration": 120
    },
    "api/referral-integrity.js": {
      "maxDuration": 300
    },
    "api/social-analyse.js": {
      "maxDuration": 60
    },
    "api/social-rollup.js": {
      "maxDuration": 60
    },
    "api/identity-resolver.js": {
      "maxDuration": 60
    },
    "api/reconcile.js": {
      "maxDuration": 60
    },
    "api/econ-dashboard.js": {
      "maxDuration": 60
    },
    "api/social-dashboard.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/drain",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/lapse-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/sms-inbound-poll",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/nightly-rollup",
      "schedule": "15 18 * * *"
    },
    {
      "path": "/api/survey-uid-topup",
      "schedule": "40 18 * * *"
    },
    {
      "path": "/api/meta-lead-pull?apply=1&days=2",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/sms-queue",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/ad-insights",
      "schedule": "5,35 * * * *"
    },
    {
      "path": "/api/social-analyse",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/social-rollup?days=3",
      "schedule": "25 18 * * *"
    },
    {
      "path": "/api/identity-resolver",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/unit-economics",
      "schedule": "45 18 * * *"
    },
    {
      "path": "/api/referral-integrity",
      "schedule": "10 * * * *"
    }
  ]
}
