{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/petition",
      "destination": "/take-action/defend-sacred-ground#sign",
      "permanent": false
    },
    {
      "source": "/sign",
      "destination": "/take-action/defend-sacred-ground#sign",
      "permanent": false
    },
    {
      "source": "/take-action",
      "destination": "/take-action/defend-sacred-ground",
      "permanent": false
    },
    {
      "source": "/demand",
      "destination": "/minister#ff-email-form",
      "permanent": false
    },
    {
      "source": "/contact-the-minister",
      "destination": "/minister",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/about-us",
      "permanent": false
    },
    {
      "source": "/evidence",
      "destination": "/the-issue",
      "permanent": false
    },
    {
      "source": "/issue",
      "destination": "/the-issue",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/content/site.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/drain",
      "schedule": "* * * * *"
    }
  ]
}
